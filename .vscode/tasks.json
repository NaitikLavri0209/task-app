{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run TaskFlow web app",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"--build",
				"-d"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run TaskFlow API",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"server"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run TaskFlow web client",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"client",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}